{
  "name": "@frontdesk/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local --schema public > src/database.types.ts"
  },
  "devDependencies": {
    "@frontdesk/core": "*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "pg": "^8.16.0",
    "supabase": "^2.122.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
