# Copy to apps/web/.env.local. Without these the app runs in demo mode
# (mock data, no login), which is fine for UI work.
#
# Local Supabase: `npm run db:start -w @frontdesk/db` prints these values.
# Supabase cloud: Project Settings → API (URL, anon key, service_role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Which LLM answers customers: groq (default, free) or claude (paid).
LLM_PROVIDER=groq

# Groq (console.groq.com → API Keys). Free tier, no card needed. Server only.
GROQ_API_KEY=
# Optional: any Groq model with tool use (default openai/gpt-oss-120b).
GROQ_MODEL=

# Claude, for LLM_PROVIDER=claude (console.anthropic.com → API keys). Server only.
ANTHROPIC_API_KEY=
# Optional: override the default model (claude-haiku-5-5).
FRONTDESK_MODEL=

# Optional: Langfuse tracing (cloud.langfuse.com → project → API keys).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com

# --- Day 4-5: knowledge base -------------------------------------------------
# Optional: Gemini embeddings for meaning-based search (aistudio.google.com →
# Get API key; free tier). Without it, search is keyword-only.
GEMINI_API_KEY=
# Optional: embedding model (default gemini-embedding-001, 768 dims).
EMBEDDING_MODEL=

# Optional: background jobs. Locally run `npx inngest-cli@latest dev` and set
# INNGEST_DEV=1. On Vercel, the Inngest integration sets the two keys.
# Without any of these, documents are processed inline after upload.
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Day 6: embeddable widget ------------------------------------------------
# Public URL of this app, used in the embed snippet (e.g. https://frontdesk-ai.vercel.app).
# Leave empty locally; it's taken from the request.
NEXT_PUBLIC_APP_URL=
# Optional: shared rate limits across servers (console.upstash.com → Redis →
# REST API). Without them, limits are kept in memory per server process.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: max chat messages per business per day (default 3000).
CHAT_DAILY_LIMIT_PER_BUSINESS=

# --- Day 9: payments -----------------------------------------------------------
# Optional: Razorpay Payment Links for booking advances (dashboard.razorpay.com →
# Account & Settings → API Keys; test keys work without KYC). Without them,
# local development shows a test payment page, and the live site confirms
# bookings at once (owners can still mark advances paid in Bookings).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when adding the webhook (Settings → Webhooks):
# URL https://<your-domain>/api/razorpay/webhook, events payment_link.paid,
# payment_link.expired, payment_link.cancelled.
RAZORPAY_WEBHOOK_SECRET=

# --- Day 12: owner alerts and error monitoring ----------------------------------
# Optional: email alerts to the owner (resend.com → API Keys; free 3,000/month).
# Without it, alerts are only written to the server log.
RESEND_API_KEY=
# Sender address. Resend's test sender (the default) only delivers to the email
# you signed up to Resend with; verify your own domain in Resend to email anyone.
ALERTS_FROM=
# Optional: error monitoring (sentry.io → new Next.js project → Client Keys / DSN;
# free 5,000 errors/month). The same DSN goes in both.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
